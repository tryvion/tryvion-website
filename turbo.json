{
  "$schema": "https://turbo.build/schema.json",

  "globalEnv": [
    "DATABASE_URL",
    "PAYLOAD_SECRET",
    "CMS_ADMIN_ALLOWED_ORIGIN",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_API_URL"
  ],

  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },

    "lint": {},

    "typecheck": {},

    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": true
    },

    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },

    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "cache": false
    },

    "clean": {
      "cache": false
    }
  }
}
