# =============================================================
# TRYVION CMS — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Mac local: postgresql://postgres:password@localhost:5432/tryvion
# Vercel/Neon/Supabase: use the connection string provided by the provider
DATABASE_URL=postgresql://postgres:password@localhost:5432/tryvion

# Payload CMS secret — must be a strong random string in production
# Generate: openssl rand -base64 32
PAYLOAD_SECRET=

# URL of the Next.js web app (used for CORS allow-list)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL of this CMS server itself (used by the web app to fetch content)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# (Optional) Extra origin allowed to call the Payload REST API
# Defaults to http://localhost:3001 if not set
CMS_ADMIN_ALLOWED_ORIGIN=http://localhost:3001
